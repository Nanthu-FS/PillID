# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Vercel AI Gateway.
# On Vercel no key is needed: the deployment authenticates with its OIDC token.
# For local development, create a key in the Vercel dashboard (AI Gateway → API keys).
AI_GATEWAY_API_KEY=

# Model ID exactly as listed by the gateway. Must accept image input.
AI_GATEWAY_MODEL=flint-v1.0

# Optional: per-user limits per rolling 24 hours (defaults shown).
# IDENTIFY_DAILY_LIMIT=25
# INTERACTIONS_DAILY_LIMIT=15
